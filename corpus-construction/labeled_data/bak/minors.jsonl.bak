{"review_id":"8bd565d1-f74b-4939-a52f-b35048539cff","app_id":"com.playrix.fishdomdd.gplay","game_name":"Fishdom","market":"UK","review_date":"2020-12-05","star_rating":4,"review_text":"I love playing but, WAY to expensive. You should get A LOT more boost, purple diamonds, torpedoes, hammers, gloves etc... I've been in the middle of a game a few times and it froze and/or quit. When it restarts it doesn't return to last game, I loose a life, my status and all of my start up boots! Messed up thing is, while I was texting my frustrations about that, it quit mid game on my other phone while I'm writing this review. Ironic? Maybe. But, definitely messed up! Still a cool game.","stratum":"targeted","seed_keyword":"quit mid game","casino":false,"T_PlayingByAppointment":0,"T_DailyRewards":0,"T_Grinding":0,"T_Advertisement":0,"T_InfiniteTreadmill":0,"T_MandatoryMarathon":1,"M_PayToProgress":0,"M_IntermediateCurrency":0,"M_DeceptiveLuxury":0,"M_RecurringFee":0,"M_Gambling":0,"M_PowerCreep":0,"M_WasteAversion":0,"M_EasyToPurchase":0,"M_UIMisdirection":0,"M_NeverEndingLure":0,"S_ForcedFellowship":0,"S_FriendSpamImpersonation":0,"S_Reciprocity":0,"S_EncouragesAntiSocialBehavior":0,"S_FearOfMissingOutFOMO":0,"S_Competition":0,"P_EasyToGetHardToLose":0,"P_CompleteTheCollection":0,"P_IllusionOfControl":0,"P_AestheticManipulation":0,"P_OptimismAndFrequencyBiases":0,"P_RewardMania":0,"Tech_FragmentedDownloads":0,"none":0,"labels_str":"T: Mandatory Marathon","confidence":"","rule_applied":"","borderline":0,"rationale":"","flagged":0,"pass":"1","codebook_version":"v1.0","saved":1,"saved_at":"2026-08-19T09:38:08.029Z","labels":["T_MandatoryMarathon"]}
