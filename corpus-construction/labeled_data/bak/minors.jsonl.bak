{"review_id":"286a5503-f7ac-475e-ad9b-5cfeec70bc59","app_id":"com.superplaystudios.dicedreams","game_name":"Dice Dreams™️","market":"US","review_date":"2022-11-21","star_rating":1,"review_text":"Being robbed of profit from attacking someone, it crashes every single time. The more bonuses you c4am into the game, the worse it gets on being able to play. The non-stop crashing is making it increasingly difficult to enjoy this game. I used to love it, now it just tries my patience. Uninstall and reinstall hasn't helped. Fix the game!!","stratum":"targeted","seed_keyword":"profit from attacking","casino":false,"T_PlayingByAppointment":0,"T_DailyRewards":0,"T_Grinding":0,"T_Advertisement":0,"T_InfiniteTreadmill":0,"T_MandatoryMarathon":0,"M_PayToProgress":0,"M_IntermediateCurrency":0,"M_DeceptiveLuxury":0,"M_RecurringFee":0,"M_Gambling":0,"M_PowerCreep":0,"M_WasteAversion":0,"M_EasyToPurchase":0,"M_UIMisdirection":0,"M_NeverEndingLure":0,"S_ForcedFellowship":0,"S_FriendSpamImpersonation":0,"S_Reciprocity":0,"S_EncouragesAntiSocialBehavior":0,"S_FearOfMissingOutFOMO":0,"S_Competition":1,"P_EasyToGetHardToLose":0,"P_CompleteTheCollection":0,"P_IllusionOfControl":0,"P_AestheticManipulation":0,"P_OptimismAndFrequencyBiases":0,"P_RewardMania":0,"Tech_FragmentedDownloads":0,"none":0,"labels_str":"S: Competition","confidence":"","rule_applied":"","borderline":0,"rationale":"","flagged":0,"pass":"1","codebook_version":"v1.0","saved":1,"saved_at":"2026-08-19T09:38:12.598Z","labels":["S_Competition"]}
